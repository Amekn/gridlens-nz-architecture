    },
    {
      "id": "g1-d04-assessment-policy",
      "phase": "requirements",
      "owner": "user",
      "question": "Choose the policy for low/moderate/high/insufficient assessment outcomes: conservative evidence-first gates, the drafted simplified heuristic thresholds, or insufficient-evidence until professional thresholds are supplied.",
      "status": "resolved",
      "resolution": "Approved recommended conservative evidence-first assessment policy, including preliminary electricity added-peak bands <=5%, >5-15%, >15%; source-backed regional water thresholds; verified resilience/economic gates; and no low community concern without representative consultation.",
      "created_at": "2026-08-06T02:49:46+00:00",
      "resolved_at": "2026-08-06T02:58:56+00:00",
      "resolved_by": "user"
    },
    {
      "id": "g1-d05-evidence-freshness",
      "phase": "requirements",
      "owner": "user",
      "question": "Choose how evidence age affects assessments: recommended category-specific freshness limits with stale/unknown unable to support a non-insufficient outcome, one global age limit, or display-only freshness.",
      "status": "resolved",
      "resolution": "Approved recommended category-specific freshness policy: 24 months for electricity/grid/water/resilience/employment/investment/community-current evidence; 36 months for cooling/planning/environmental evidence; source validUntil override; missing date unknown; stale/unknown visible but cannot support low concern.",
      "created_at": "2026-08-06T02:49:46+00:00",
      "resolved_at": "2026-08-06T02:58:56+00:00",
      "resolved_by": "user"
    },
    {
      "id": "g3-d01-fossil-assumption",
      "phase": "logic",
      "owner": "user",
      "question": "May an explicit user assertion of unrestricted diesel/gas/mixed backup produce a conservative high-concern resilience outcome without current authoritative evidence, provided the reason traces that assumption?",
      "status": "resolved",
      "resolution": "Approved recommended policy: an explicit unrestricted fossil-backup assertion may produce conservative high concern when the reason traces the user assumption.",
      "created_at": "2026-08-06T04:24:15+00:00",
      "resolved_at": "2026-08-06T04:43:45+00:00",
      "resolved_by": "user"
    },
    {
      "id": "g3-d02-economic-high",
      "phase": "logic",
      "owner": "user",
      "question": "Should economic high concern require an exact contradiction from current authoritative evidence, while jobs above 10,000 remains a suspicion warning/moderate unsupported claim and no investment high threshold is invented?",
      "status": "resolved",
      "resolution": "Approved recommended policy: economic high concern requires exact contradictory current authoritative evidence; jobs above 10,000 remains a warning/moderate unsupported claim; no investment high threshold is invented.",
      "created_at": "2026-08-06T04:24:15+00:00",
      "resolved_at": "2026-08-06T04:43:45+00:00",
      "resolved_by": "user"
    },
    {
      "id": "g1-d06-byok-mcp-security",
      "phase": "requirements",
      "owner": "user",
      "question": "Approve session-only BYOK credentials, direct browser-to-CORS-enabled OpenAI-compatible endpoint calls, no key persistence/app relay, and remote HTTP MCP limited to allowlisted search/research tools with Tavily as the tested preset?",
      "status": "resolved",
      "resolution": "Credentials must persist across refresh after first use in device-local browser storage; calls remain direct from browser to CORS-enabled OpenAI-compatible and remote MCP endpoints; credentials must be masked, never logged/exported/cloud-synced, and have explicit per-connector clear controls.",
      "created_at": "2026-08-06T04:43:45+00:00",
      "resolved_at": "2026-08-06T05:10:18+00:00",
      "resolved_by": "user"
    },
    {
      "id": "g1-d07-ai-authority",
      "phase": "requirements",
      "owner": "user",
      "question": "Approve LLM/MCP as evidence discovery, extraction, and commentary only, with deterministic validated calculations and assessment outcomes remaining authoritative?",
      "status": "resolved",
      "resolution": "Approved LLM/MCP agent throughout the product while deterministic validated calculations and assessments remain authoritative; add a prompt workspace for user-led research/analysis and dynamically generated visualisations.",
      "created_at": "2026-08-06T04:43:46+00:00",
      "resolved_at": "2026-08-06T05:10:18+00:00",
      "resolved_by": "user"
    },
    {
      "id": "g1-d08-nz-data-coverage",
      "phase": "requirements",
      "owner": "user",
      "question": "For v1, should all NZ regions be selectable while Southland/Waikato/Auckland retain full quantitative support, other regions show limited/incomplete evaluation, EM6 anonymous feeds are live context, and LAWA uses licensed versioned downloads rather than scraping?",
      "status": "resolved",
      "resolution": "All of New Zealand must be selectable and supported rather than limiting full evaluation to Southland, Waikato, and Auckland; retain EM6 anonymous feeds and use multiple stronger free public sources where available.",
      "created_at": "2026-08-06T04:43:46+00:00",
      "resolved_at": "2026-08-06T05:10:19+00:00",
      "resolved_by": "user"
    },
